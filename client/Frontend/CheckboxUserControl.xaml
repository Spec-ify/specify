<UserControl x:Class="specify_client.Frontend.CheckboxUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:specify_client.Frontend"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border CornerRadius="8"
            BorderThickness="2"
            BorderBrush="#576277"
            Margin="2,2">

        <CheckBox Name="DontUploadCheckbox" Margin="5,0"
              IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=local:CheckboxUserControl}}"
              Style="{DynamicResource CheckBoxStyle1}"
              Foreground="White"
              VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" Padding="0">
            
            <TextBlock VerticalAlignment="Center"
                FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                TextAlignment="Center" TextWrapping="Wrap"
                Text="{Binding Content, RelativeSource={RelativeSource AncestorType=local:CheckboxUserControl}}"
                />
        </CheckBox>
    </Border>
</UserControl>
